# Copie ce fichier en .env.local et remplis les valeurs.
EXPO_PUBLIC_SUPABASE_URL=https://supabase.example.com
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Clé MapTiler (free tier). Sans clé, la carte retombe sur les tuiles démo MapLibre (pays seulement).
EXPO_PUBLIC_MAPTILER_KEY=
# URL web publique des invitations (https://pinpals.app/join/CODE). Sans valeur : lien pinpals://
EXPO_PUBLIC_WEB_URL=https://pinpals.app
